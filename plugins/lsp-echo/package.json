{
  "name": "@dsh-user/lsp-echo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.3",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "files": [
    "lib/",
    "checkers/",
    "cordis.patch.yml",
    "README.md"
  ],
  "description": "Self-contained language-server diagnostics echo for the DeepSeek Harness. Manages bundled checker engines (Godot LSP first) and auto-injects compile diagnostics into agent context after file edits. No npm dependencies; @deepseek-ai/* services resolve from the profile node_modules at load time.",
  "license": "UNLICENSED"
}
